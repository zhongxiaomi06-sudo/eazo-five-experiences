{
  "name": "eazo-five-experiences",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "D2-entry engineering workspace for five Eazo mobile-first experiences.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0 <27",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:day": "pnpm --filter @eazo/ideal-day-lab dev",
    "dev:space": "pnpm --filter @eazo/scroll-to-space dev",
    "dev:life": "pnpm --filter @eazo/life-elsewhere-now dev",
    "dev:year": "pnpm --filter @eazo/who-shared-the-year dev",
    "dev:lab": "pnpm --filter @eazo/weird-matter-lab dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "oxlint --deny-warnings packages apps scripts",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "manifest:generate": "node scripts/generate-manifests.mjs",
    "manifest:validate": "node scripts/validate-manifests.mjs",
    "export:apps": "node scripts/export-apps.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm manifest:validate && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.80.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
